# Copy to .env and adjust. Never commit .env.

# Runtime DB (local docker compose: host port 5434).
# Production (Vercel): Supabase *transaction pooler* URI (port 6543), append ?sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/order_screen

# Used by migrations/seed if set (Supabase *session pooler* URI, port 5432, ?sslmode=require).
# DIRECT_URL=

# Integration tests (vitest "integration" project) — truncated and reseeded by the tests.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/order_screen_test

# Playwright e2e database.
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5434/order_screen_e2e

# HS256 secret for session JWTs, at least 32 characters (prod: `openssl rand -base64 48`).
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
